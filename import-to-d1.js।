```javascript
const fs = require("fs");
const zlib = require("zlib");

const ACCOUNT = process.env.CLOUDFLARE_ACCOUNT_ID;
const DATABASE = process.env.CLOUDFLARE_D1_DATABASE_ID;
const TOKEN = process.env.CLOUDFLARE_API_TOKEN;

const FILE = "data.json.gz";
const TABLE = "movies";
const BATCH_SIZE = 5;

const columns = [
  "id", "kind", "slug", "name", "poster", "backdrop",
  "year", "overview", "rating", "genres", "runtime",
  "imdb", "tmdb", "trailer", "episodes", "detail_url", "links"
];

function jsonText(value) {
  if (value == null) return null;
  return typeof value === "string" ? value : JSON.stringify(value);
}

function normalize(item, index) {
  const kind = String(item.kind || item.type || "movie").toLowerCase();
  const name = item.name || item.title || `Item ${index + 1}`;
  const slug = item.slug || item.id || name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
  const id = String(item.id || `${kind}:${slug}`);

  return [
    id, kind, String(slug), String(name),
    item.poster || item.posterUrl || null,
    item.backdrop || item.background || null,
    Number.isFinite(Number(item.year)) && item.year != null
      ? Number(item.year) : null,
    item.overview || item.description || null,
    Number.isFinite(Number(item.rating)) && item.rating != null
      ? Number(item.rating) : null,
    jsonText(item.genres),
    item.runtime == null ? null : String(item.runtime),
    item.imdb || item.imdb_id || null,
    item.tmdb == null ? (item.tmdb_id == null ? null : String(item.tmdb_id)) : String(item.tmdb),
    item.trailer || null,
    jsonText(item.episodes),
    item.detail_url || item.url || null,
    jsonText(item.links || item.streams)
  ];
}

async function main() {
  if (!ACCOUNT || !DATABASE || !TOKEN) {
    throw new Error("Missing Cloudflare GitHub Secrets.");
  }

  if (!fs.existsSync(FILE)) {
    throw new Error("data.json.gz not found.");
  }

  const compressed = fs.readFileSync(FILE);
  if (compressed.length < 100) {
    throw new Error("data.json.gz is a placeholder, not a catalog.");
  }

  const parsed = JSON.parse(zlib.gunzipSync(compressed).toString("utf8"));
  const items = Array.isArray(parsed)
    ? parsed
    : parsed.items || parsed.metas || parsed.results;

  if (!Array.isArray(items) || items.length === 0) {
    throw new Error("No catalog items found in the JSON file.");
  }

  const url =
    `https://api.cloudflare.com/client/v4/accounts/${ACCOUNT}` +
    `/d1/database/${DATABASE}/query`;

  const headers = {
    Authorization: `Bearer ${TOKEN}`,
    "Content-Type": "application/json"
  };

  let saved = 0;

  for (let start = 0; start < items.length; start += BATCH_SIZE) {
    const batch = items.slice(start, start + BATCH_SIZE)
      .map(normalize);

    const placeholders = batch.map(() =>
      `(${columns.map(() => "?").join(",")})`
    ).join(",");

    const sql = `
      INSERT INTO ${TABLE} (${columns.join(",")})
      VALUES ${placeholders}
      ON CONFLICT(id) DO UPDATE SET
      ${columns.filter(c => c !== "id")
        .map(c => `${c}=excluded.${c}`).join(",")}
    `;

    const params = batch.flat();

    let success = false;

    for (let attempt = 1; attempt <= 5; attempt++) {
      const response = await fetch(url, {
        method: "POST",
        headers,
        body: JSON.stringify({ sql, params })
      });

      const result = await response.json();

      if (response.ok && result.success) {
        success = true;
        break;
      }

      if (attempt === 5) {
        throw new Error(
          `D1 import failed at item ${start + 1}: ` +
          JSON.stringify(result.errors || result).slice(0, 1000)
        );
      }

      await new Promise(resolve =>
        setTimeout(resolve, attempt * 2000)
      );
    }

    if (!success) throw new Error("Batch import failed.");

    saved += batch.length;

    if (saved % 100 === 0 || saved === items.length) {
      console.log(`Imported ${saved}/${items.length}`);
    }
  }

  console.log(`SUCCESS: imported ${saved} catalog items into D1.`);
}

main().catch(error => {
  console.error(error);
  process.exit(1);
});
